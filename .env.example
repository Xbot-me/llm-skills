# Fill in keys only for the providers you actually want to test against.
# The harness skips a provider gracefully if its key is missing, rather
# than failing the whole run.

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Used when a case runs without --models specified.
# Format: provider:model, comma-separated. Check current model IDs at
# docs.claude.com / ai.google.dev / console.groq.com/docs/models before
# relying on any example here.
DEFAULT_MODELS=anthropic:claude-sonnet-4-5

# The judge scores every target model's response. Keep it a different
# model/provider than what you're testing when possible, to reduce
# self-grading bias.
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-4-5
